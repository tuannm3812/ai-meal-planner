rules_version = '2';
// DEC-43: only the API reads and writes Firestore, through its service
// account, which these rules do not apply to. No browser may touch it
// directly: the React app goes through the API, which checks the sign-in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

# Base URL of the FastAPI backend. Vite only exposes vars prefixed with VITE_.
# Copy to frontend/.env.local for local development.
VITE_API_URL=http://localhost:8000

# DEC-43: signed-in accounts. Leave these empty to run without accounts (the
# default for a local API). The Firebase web config is public, not a secret;
# copy it from the Firebase console's project settings.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
